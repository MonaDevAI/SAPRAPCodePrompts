{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/MonaDevAI/SAPRAPCodePrompts/rap-project.schema.json",
  "title": "SAP RAP Copilot project",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "target", "businessObject", "ui"],
  "properties": {
    "$schema": { "type": "string" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appId", "title", "entity", "entitySet", "shortName", "namespacePrefix", "outputDirectory"],
      "properties": {
        "appId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$" },
        "title": { "$ref": "#/definitions/label" },
        "entity": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,29}$" },
        "entitySet": { "$ref": "#/definitions/identifier" },
        "shortName": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{0,7}$" },
        "namespacePrefix": { "type": "string", "pattern": "^[ZY][A-Z0-9]{0,4}$" },
        "uiMode": {
          "enum": ["adt-preview", "standalone"],
          "default": "adt-preview",
          "description": "Default to RAP objects, UI annotations, and ADT preview instructions. Generate standalone frontend projects only when explicitly selected."
        },
        "outputDirectory": { "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "adtProject", "package", "transport", "abapLanguageVersion", "odataVersion", "ui5Version"],
      "properties": {
        "mode": { "enum": ["source-only", "connected"] },
        "adtProject": { "type": "string" },
        "package": { "type": "string", "pattern": "^(\\$TMP|[ZY][A-Z0-9_]{0,29})$" },
        "transport": { "type": ["string", "null"], "minLength": 1 },
        "abapLanguageVersion": { "enum": ["cloud", "standard"] },
        "odataVersion": { "const": "4.0" },
        "ui5Version": { "type": ["string", "null"], "pattern": "^1\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "businessObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "draft", "fields"],
      "properties": {
        "implementation": { "const": "managed" },
        "draft": { "const": true },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/field" }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectionFields", "lineItems", "fieldGroups"],
      "properties": {
        "selectionFields": { "$ref": "#/definitions/fieldReferences" },
        "lineItems": { "$ref": "#/definitions/fieldReferences" },
        "fieldGroups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "fields"],
            "properties": {
              "id": { "$ref": "#/definitions/identifier" },
              "label": { "$ref": "#/definitions/label" },
              "fields": { "$ref": "#/definitions/fieldReferences" }
            }
          }
        },
        "overview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cards"],
          "properties": {
            "cards": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  { "$ref": "#/definitions/listCard" },
                  { "$ref": "#/definitions/chartCard" }
                ]
              }
            }
          }
        },
        "analytics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dimensions", "measures", "chart"],
          "properties": {
            "dimensions": { "$ref": "#/definitions/fieldReferences" },
            "measures": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["field", "aggregation"],
                "properties": {
                  "field": { "$ref": "#/definitions/identifier" },
                  "aggregation": { "enum": ["SUM", "MIN", "MAX", "AVG"] }
                }
              }
            },
            "chart": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "dimension", "measure"],
              "properties": {
                "type": { "enum": ["column", "bar", "line", "donut"] },
                "dimension": { "$ref": "#/definitions/identifier" },
                "measure": { "$ref": "#/definitions/identifier" }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,29}$" },
    "label": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "fieldReferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/identifier" }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "type"],
      "properties": {
        "name": { "$ref": "#/definitions/identifier" },
        "label": { "$ref": "#/definitions/label" },
        "type": { "enum": ["string", "date", "integer", "boolean", "decimal", "amount", "currency", "quantity", "unit"] },
        "length": { "type": "integer", "minimum": 1, "maximum": 1333 },
        "precision": { "type": "integer", "minimum": 1, "maximum": 31 },
        "scale": { "type": "integer", "minimum": 0, "maximum": 14 },
        "currencyField": { "$ref": "#/definitions/identifier" },
        "unitField": { "$ref": "#/definitions/identifier" },
        "required": { "type": "boolean" },
        "readOnly": { "type": "boolean" },
        "default": { "type": ["string", "number", "boolean"] },
        "allowedValues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": { "type": "string" },
              "label": { "$ref": "#/definitions/label" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "string" } } },
          "then": { "required": ["length"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["decimal", "amount", "quantity"] } } },
          "then": { "required": ["precision", "scale"] }
        },
        {
          "if": { "properties": { "type": { "const": "amount" } } },
          "then": { "required": ["currencyField"] }
        },
        {
          "if": { "properties": { "type": { "const": "quantity" } } },
          "then": { "required": ["unitField"] }
        }
      ]
    },
    "listCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "fields", "sortBy", "sortDescending"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "kind": { "const": "list" },
        "title": { "$ref": "#/definitions/label" },
        "fields": { "$ref": "#/definitions/fieldReferences" },
        "sortBy": { "$ref": "#/definitions/identifier" },
        "sortDescending": { "type": "boolean" }
      }
    },
    "chartCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "dimension", "measure"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "kind": { "const": "chart" },
        "title": { "$ref": "#/definitions/label" },
        "dimension": { "$ref": "#/definitions/identifier" },
        "measure": { "$ref": "#/definitions/identifier" }
      }
    }
  }
}
